{
  "name": "guhbot-discord",
  "version": "2.0.0",
  "description": "GuhBot, a Discord bot with slash commands, built with discord.ts (discordx).",
  "private": true,
  "type": "module",
  "main": "build/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env build/main.js",
    "dev": "tsc && npm start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "@discordx/utilities": "^8.0.0",
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1",
    "discordx": "^11.13.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
