# Copy this file to .env on each machine and fill in real values.
# Never commit .env. Share secrets through a password manager.
# Each setting here must also be listed under environment in compose.yaml.

# Image tag to run:
#   1.2.3   A specific release. Use this to pin or roll back.
#   latest  The newest release.
#   main    The newest merge to main, for testing.
APP_VERSION=latest

# Settings and secrets the bot reads as environment variables.
# Use separate values for development and production. Develop with the test
# bot's token, not the production bot's.

# Required. The bot token from the Discord Developer Portal, under Bot.
DISCORD_TOKEN=replace-me

# Registers every command in this server instead of globally, so changes
# appear at once. Set it while developing and leave it empty in production.
DEV_GUILD_ID=

# Registers /setstatus and /logout in this server only. Only the owners of
# the Discord application can run them. Leave empty to turn them off.
OWNER_GUILD_ID=

# The modules to turn on, separated by commas, such as fun,games,misc.
# Leave empty to turn on every module. Meta is always on. The modules are
# fun, games, images, misc, moderation, roleplay, archivist, and meta.
MODULES=

# The servers where the Archivist module works, as IDs separated by commas.
# Its commands appear only in these servers. Leave empty to turn it off.
ARCHIVIST_GUILD_IDS=

# The channel where the bot announces when it starts and logs out.
STATUS_CHANNEL_ID=

# Links shown by /support, /stats, and /upvote. Leave one empty to hide it.
SUPPORT_URL=https://discord.gg/PBmfvpU
WEBSITE_URL=
TOPGG_URL=https://top.gg/bot/624754986248831017/vote
DISCORDBOTLIST_URL=https://discordbotlist.com/bots/guhbot/upvote
